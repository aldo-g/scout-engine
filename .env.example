# Optional. Google results via https://serper.dev (free tier available).
# Without it the server falls back to Brave Search, which ignores the after: date filter
# and rate-limits bursts of requests.
SERPER_API_KEY=

# Enables the first-pass model judgement (logo, name, description) in screen.js.
# Without it the first pass runs the exclusion rules only.
ANTHROPIC_API_KEY=

# Paid Serper plans only: results per query (max 100) and pages per query. Free tier is 10 and 1.
SERPER_NUM=
SERPER_PAGES=

# Optional tuning. Defaults shown.
# PORT=8765                  Local server port (binds to 127.0.0.1 only)
# CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome   Headless Chrome for website screenshots
# DISCOVER_BUDGET=12         Max queries per discovery run (8 without a Serper key)
# BRAVE_PAGES=1              Result pages per query when scraping Brave (no Serper key)
